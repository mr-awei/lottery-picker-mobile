{
  "name": "lottery-picker-mobile",
  "version": "1.11.0",
  "description": "彩票选号器手机版：双色球 + 大乐透，含往期号码、分布图、走势图、最大奖、中奖地图、AI选号、自选号、文本查中奖、知识库、设置",
  "author": "Marvis",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run type-check && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .js,.vue,.ts",
    "lint:fix": "eslint . --ext .js,.vue,.ts --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{js,vue}\"",
    "cap:sync": "vite build && cap sync android",
    "cap:apk": "vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "push:all": "git push origin --all && git push origin --tags && git push gitee --all && git push gitee --tags"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "echarts": "^5.5.0",
    "element-plus": "^2.7.0",
    "tesseract.js": "^5.1.1",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
